# ===== Resend transactional email =====
# Verify updates.jackhunter.com and create a key scoped to application delivery.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="Hunter Group <hello@updates.jackhunter.com>"
RESEND_CAPITAL_FROM_EMAIL="Equity Market <advisors@noreply.equitymarket.io>"
RESEND_REPLY_TO=hello@jackhunter.com
# Separate key used only by Supabase Auth SMTP.
RESEND_SUPABASE_AUTH_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Production webhook signing secret.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ===== Public site URL =====
# Used for absolute links in the guide email
NEXT_PUBLIC_SITE_URL=https://jackhunter.com

# The portal is hosted by this Vercel project on its dedicated domain. Must
# match the Supabase Auth "Site URL" and PORTAL_HOSTS in
# lib/equity-market/portal-domain.ts.
# Renamed from NEXT_PUBLIC_HNC_SITE_URL, which is still read as a fallback.
NEXT_PUBLIC_PORTAL_SITE_URL=https://equitymarket.io

# ===== PostHog (product analytics + session replay) =====
# Project API key from PostHog → Settings → Project → "Project API Key" (starts with phc_)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Region host: https://us.posthog.com (US) or https://eu.posthog.com (EU)
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# ===== Intercom (live chat on the site and the Equity Market portal) =====
# Workspace id from Intercom → Settings → Installation. Public by design; the
# app already falls back to the production id, so this is only an override.
NEXT_PUBLIC_INTERCOM_APP_ID=hknj0uly
# Workspace region: us (default), eu or ap.
NEXT_PUBLIC_INTERCOM_REGION=us
# Set to "true" locally to keep dev sessions out of the live Intercom workspace.
NEXT_PUBLIC_INTERCOM_DISABLED=
# Messenger API secret ("Unified Secret") from Intercom → Settings → Channels →
# Messenger → Security. Signs the HS256 identity JWT. SERVER ONLY — never
# prefix with NEXT_PUBLIC_, and never put JWT-signing code in the browser.
# Until this is set, signed-in users get an ANONYMOUS messenger: the server
# refuses to identify anyone it cannot sign for.
INTERCOM_MESSENGER_SECRET=

# ===== Equity Market portal (Supabase) =====
# Use the hosted project's URL and publishable key. Never expose the secret or
# service-role key through a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://sltthjfmbsgaufbbdowz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_a1zIdjPaJMt990m4eONH8Q_54nzPbP_

# When true, authenticated portal routes require a verified Supabase session
# instead of using the local preview personas.
# Renamed from HNC_REQUIRE_AUTH, which is still read as a fallback.
PORTAL_REQUIRE_AUTH=true

# Server-only administrative access for trusted route handlers and background
# tasks. Do not expose this value to the browser.
SUPABASE_WEB_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxx

# Hosted project reference used by operational tooling and support.
SUPABASE_PROJECT_REF=sltthjfmbsgaufbbdowz

# ===== Public abuse prevention and scheduled delivery =====
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4xxxxxxxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4xxxxxxxxxxxxxxxxxxxx
CRON_SECRET=generate-a-long-random-value

# ===== Google Street View (building card imagery) =====
# Server-only. Restrict the key to the "Street View Static API" in Google Cloud.
# Needed ONLY to pull building photos, once, via scripts/pull-street-view.ts.
# Pulled images live in Supabase Storage and are served with no key thereafter,
# so most machines never need this set. See scripts/README-street-view.md.
GOOGLE_MAPS_API_KEY=
