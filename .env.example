# ===== Public site URL =====
# Used for absolute links in metadata, robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=https://huntergroupremax.com

# Where the "Investment" links and the retired portal paths point.
# The funds portal is its own app (github.com/jackhunterking/equity-market);
# defaults to https://www.equitymarket.io when unset (see next.config.mjs).
NEXT_PUBLIC_PORTAL_URL=https://www.equitymarket.io

# ===== PostHog (product analytics + session replay) =====
# Project API key from PostHog → Settings → Project → "Project API Key" (starts with phc_)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Region host: https://us.posthog.com (US) or https://eu.posthog.com (EU)
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# Private property workspace (separate from NEXT_PUBLIC_PORTAL_URL / Equity Market).
NEXT_PUBLIC_PROPERTY_WORKSPACE_URL=https://app.huntergroupremax.com
